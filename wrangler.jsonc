{
  "name": "axis-repository",
  "main": "packages/runtime-cloudflare/src/index.ts",
  "compatibility_date": "2026-07-12",
  "r2_buckets": [
    {
      "binding": "AXIS_OBJECTS",
      "bucket_name": "axis-repository"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AXIS_ADMIN",
        "class_name": "AxisAdminDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "create-axis-admin-do",
      "new_sqlite_classes": ["AxisAdminDO"]
    }
  ]
}
