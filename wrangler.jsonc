{
  "name": "axis-repository",
  "main": "packages/runtime-cloudflare/src/index.ts",
  "compatibility_date": "2026-07-12",
  "vars": {
    // The bucket presigned upload URLs are signed against. It names the same
    // bucket as the AXIS_OBJECTS binding below and has to keep naming it: the
    // binding is how the Worker reads objects, this is how a client is sent
    // to write them.
    "R2_BUCKET_NAME": "axis-repository"
  },
  "r2_buckets": [
    {
      "binding": "AXIS_OBJECTS",
      "bucket_name": "axis-repository"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AXIS_ADMIN",
        "class_name": "AxisAdminDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "create-axis-admin-do",
      "new_sqlite_classes": ["AxisAdminDO"]
    }
  ]
}
