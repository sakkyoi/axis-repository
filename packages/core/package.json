{
  "name": "@axis-repository/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./archives": {
      "types": "./src/archives/index.ts",
      "import": "./src/archives/index.ts",
      "default": "./src/archives/index.ts"
    },
    "./plugin-manifests": {
      "types": "./src/plugins/plugin-manifests.ts",
      "import": "./src/plugins/plugin-manifests.ts",
      "default": "./src/plugins/plugin-manifests.ts"
    },
    "./test-support": "./src/state/state-store-contract.test-support.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts src/plugins/plugin-manifests.ts src/archives/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {}
}
