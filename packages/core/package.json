{
  "name": "@axis-repository/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin-manifests": {
      "types": "./dist/plugin-manifests.d.ts",
      "import": "./dist/plugin-manifests.js",
      "default": "./dist/plugin-manifests.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/plugin-manifests.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {}
}
