{
  "name": "@axis-repository/runtime-cloudflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin-runtime": {
      "types": "./dist/plugin-runtime.d.ts",
      "import": "./dist/plugin-runtime.js",
      "default": "./dist/plugin-runtime.js"
    },
    "./plugin-runtime/testing": {
      "types": "./dist/plugin-runtime-testing.d.ts",
      "import": "./dist/plugin-runtime-testing.js",
      "default": "./dist/plugin-runtime-testing.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-admin-ui-assets.mjs && tsup src/index.ts src/plugin-runtime.ts src/plugin-runtime-testing.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axis-repository/core": "workspace:*",
    "aws4fetch": "^1.0.20",
    "openpgp": "^6.3.1"
  },
  "devDependencies": {
    "@axis-repository/admin-ui": "workspace:*",
    "@cloudflare/workers-types": "^4.20241218.0"
  }
}
