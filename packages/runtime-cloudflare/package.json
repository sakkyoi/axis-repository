{
  "name": "@axis-repository/runtime-cloudflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugin-runtime": {
      "types": "./src/plugin-runtime.ts",
      "import": "./src/plugin-runtime.ts",
      "default": "./src/plugin-runtime.ts"
    },
    "./plugin-runtime/testing": {
      "types": "./src/plugin-runtime-testing.ts",
      "import": "./src/plugin-runtime-testing.ts",
      "default": "./src/plugin-runtime-testing.ts"
    }
  },
  "imports": {
    "#admin-ui-assets-generated": "./src/admin-ui-assets/generated-empty.ts"
  },
  "scripts": {
    "build": "pnpm --filter @axis-repository/admin-ui build && pnpm run build:worker",
    "build:worker": "node scripts/generate-admin-ui-assets.mjs && tsup",
    "deploy:dry-run": "pnpm --workspace-root deploy:dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axis-repository/core": "workspace:*",
    "@axis-repository/plugin-catalog": "workspace:*",
    "@axis-repository/plugin-apt": "workspace:*",
    "@axis-repository/plugin-pypi": "workspace:*",
    "aws4fetch": "^1.0.20",
    "openpgp": "^6.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/node": "^22.10.2"
  }
}
