{
  "name": "@axis-repository/admin-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./plugin-ui": {
      "types": "./dist/plugin-ui.d.ts",
      "import": "./dist/plugin-ui.js",
      "default": "./dist/plugin-ui.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
