# Secrets a deployment cannot run without. Deploy to Cloudflare reads this file
# to know what to ask for; locally, copy it to .dev.vars and fill it in.
#
# What each value holds together, and what it costs to change, is described in
# package.json under cloudflare.bindings — the text shown beside each field.

# The first admin account, seeded on first run. Nothing else creates an account,
# so a deployment without these has no way in.
AXIS_ADMIN_USERNAME=admin
AXIS_ADMIN_PASSWORD=

# Signs admin session cookies.
AXIS_SESSION_SECRET=

# Salts publish token hashes.
TOKEN_HASH_PEPPER=

# Encrypts stored repository signing keys.
SIGNING_KEY_ENCRYPTION_SECRET=

# Signs the upload URLs a publishing client PUTs to, so artifact bytes go
# straight to R2 rather than through the Worker. Create an R2 API token in the
# dashboard under R2 > Manage API tokens, with object read and write on the
# bucket this Worker is deployed with.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Local development cannot use the three above: presigned URLs are signed
# against the real R2 endpoint, which `wrangler dev --local` does not serve. Set
# UPLOAD_BACKEND=local-r2 in .dev.vars instead and leave them blank — uploads
# then go through the Worker and into Wrangler's local bucket state.
