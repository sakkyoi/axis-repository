{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@axis-repository/core": ["packages/core/src/index.ts"],
      "@axis-repository/plugin-catalog": ["plugins/catalog.ts"],
      "@axis-repository/core/archives": ["packages/core/src/archives/index.ts"],
      "@axis-repository/core/plugin-manifests": ["packages/core/src/plugins/plugin-manifests.ts"],
      "@axis-repository/core/test-support": ["packages/core/src/state/state-store-contract.test-support.ts"],
      "@axis-repository/plugin-apt": ["plugins/apt/plugin.ts"],
      "@axis-repository/plugin-apt/admin-ui": ["plugins/apt/admin-ui/index.ts"],
      "@axis-repository/plugin-apt/admin-ui/publish": ["plugins/apt/admin-ui/publish.tsx"],
      "@axis-repository/plugin-apt/manifest": ["plugins/apt/manifest.ts"],
      "@axis-repository/plugin-apt/runtime": ["plugins/apt/runtime/runtime.ts"],
      "@axis-repository/plugin-apt/runtime/publisher": ["plugins/apt/runtime/publisher.ts"],
      "@axis-repository/plugin-apt/test-support": ["plugins/apt/runtime/deb-fixtures.test-support.ts"],
      "@axis-repository/plugin-pypi": ["plugins/pypi/plugin.ts"],
      "@axis-repository/plugin-pypi/admin-ui": ["plugins/pypi/admin-ui/index.ts"],
      "@axis-repository/plugin-pypi/admin-ui/detail": ["plugins/pypi/admin-ui/detail.tsx"],
      "@axis-repository/plugin-pypi/admin-ui/publish": ["plugins/pypi/admin-ui/publish.tsx"],
      "@axis-repository/plugin-pypi/manifest": ["plugins/pypi/manifest.ts"],
      "@axis-repository/plugin-pypi/runtime": ["plugins/pypi/runtime/runtime.ts"],
      "@axis-repository/plugin-pypi/test-support": ["plugins/pypi/shared/dist-fixtures.test-support.ts"],
      "@axis-repository/runtime-cloudflare/plugin-runtime": ["packages/runtime-cloudflare/src/plugin-runtime.ts"],
      "@axis-repository/runtime-cloudflare/plugin-runtime/testing": ["packages/runtime-cloudflare/src/plugin-runtime-testing.ts"],
      "@axis-repository/admin-ui/plugin-ui": ["packages/admin-ui/src/plugin-ui.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  }
}
