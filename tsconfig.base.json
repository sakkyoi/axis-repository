{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@axis-repository/core": ["packages/core/src/index.ts"],
      "@axis-repository/core/plugin-manifests": ["packages/core/src/plugin-manifests.ts"],
      "@axis-repository/runtime-cloudflare/plugin-runtime": ["packages/runtime-cloudflare/src/plugin-runtime.ts"],
      "@axis-repository/runtime-cloudflare/plugin-runtime/testing": ["packages/runtime-cloudflare/src/plugin-runtime-testing.ts"],
      "@axis-repository/admin-ui/plugin-ui": ["packages/admin-ui/src/plugin-ui.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  }
}
