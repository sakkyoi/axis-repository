---
import { ThemeScript, Toggle } from "astro-theme-toggle/components";
import { Icon } from "astro-icon/components";
import { fetchGithubStars } from "../lib/github";
import "../styles/tailwind.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const githubUrl = "https://github.com/sakkyoi/axis-repository";
const stargazersCount = await fetchGithubStars("sakkyoi/axis-repository");
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body class="bg-base-light font-sans text-slate-900 dark:bg-base-dark dark:text-slate-100">
    <!-- The header's own height is set entirely by the nav row inside
         #site-nav (nothing else in here establishes height). The toggle
         wrapper below spans that same height (inset-y-0) and centers
         itself in it, so it lines up with the row exactly -- not via a
         guessed pixel offset kept in sync by hand, which is what drifted
         out of alignment last time the row's own padding changed. -->
    <header class="fixed inset-x-0 top-0 z-20">
      <!-- One plain container, one opacity fade, nothing sliding --
           reveals as soon as the page leaves scrollY 0. -->
      <div
        id="site-nav"
        class="border-b border-slate-900/10 bg-base-light/80 opacity-0 backdrop-blur transition-opacity duration-300 dark:border-white/10 dark:bg-base-dark/80"
      >
        <div class="flex items-center justify-between py-4 pl-6 pr-16">
          <a href="/" class="flex items-center gap-2 font-display text-base font-semibold">
            <img src="/logo-mark-light.svg" alt="" width="28" height="28" class="dark:hidden" />
            <img
              src="/logo-mark-dark.svg"
              alt=""
              width="28"
              height="28"
              class="hidden dark:block"
            />
            Axis Repository
          </a>
          <nav class="flex items-center gap-5 text-sm">
            <a href="/docs/" class="hover:text-lime-600 dark:hover:text-lime-400">Docs</a>
            <a
              href={githubUrl}
              class="flex items-center gap-1.5 hover:text-lime-600 dark:hover:text-lime-400"
            >
              <Icon name="simple-icons:github" size={16} aria-hidden="true" />
              GitHub{stargazersCount !== null && ` · ★ ${stargazersCount}`}
            </a>
          </nav>
        </div>
      </div>

      <!-- Theme toggle: a utility control someone may want the instant
           the page loads (e.g. to fix a color scheme that's hard to
           read), not a "welcome, keep exploring" element that should
           wait, so it's never touched by the fade above. -->
      <div class="absolute inset-y-0 right-6 z-30 flex items-center">
        <Toggle
          aria-label="Toggle theme"
          style="width: 1.25rem; height: 1.25rem;"
          class="text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
        />
      </div>
    </header>

    <slot />

    <script>
      // Nav starts hidden (server-rendered opacity-0, see the header's
      // class list) so there's no flash of it being visible before this
      // runs, and reveals as soon as the page leaves scrollY 0 -- not
      // after any particular section, just "has the user scrolled at
      // all."
      //
      // The header is `fixed`, not `sticky`, so it never reserves layout
      // space: with `sticky` it still occupied its own height at the very
      // top even at opacity 0, which pushed the hero's own background
      // start down by that same height and showed as a flat strip of the
      // plain page background above the hero's gradient -- a visible
      // seam, worst in dark mode. `fixed` overlays instead, so the hero's
      // background runs all the way to the real top of the page and
      // there's nothing for the invisible header to create a gap in
      // front of.
      function setupNavReveal(): void {
        const nav = document.getElementById("site-nav");
        if (!nav) return;

        function reveal(): void {
          nav!.classList.remove("opacity-0");
          nav!.removeAttribute("inert");
        }

        function hide(): void {
          nav!.classList.add("opacity-0");
          nav!.setAttribute("inert", "");
        }

        function update(): void {
          if (window.scrollY > 8) reveal();
          else hide();
        }

        update();
        window.addEventListener("scroll", update, { passive: true });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupNavReveal);
      } else {
        setupNavReveal();
      }
      document.addEventListener("astro:page-load", setupNavReveal);
    </script>
  </body>
</html>
