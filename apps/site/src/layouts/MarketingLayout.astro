---
import { ThemeScript, Toggle } from "astro-theme-toggle/components";
import "../styles/tailwind.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const githubUrl = "https://github.com/sakkyoi/axis-repository";

let stargazersCount: number | null = null;
try {
  const response = await fetch("https://api.github.com/repos/sakkyoi/axis-repository");
  if (response.ok) {
    const data = (await response.json()) as { stargazers_count: number };
    stargazersCount = data.stargazers_count;
  }
} catch {
  // Build-time-only enhancement -- if the GitHub API is unreachable or rate
  // limited, the link still renders, just without a count.
}
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body class="bg-base-light font-sans text-slate-900 dark:bg-base-dark dark:text-slate-100">
    <!-- One plain container, one opacity fade, nothing sliding -- reveals
         as soon as the page leaves scrollY 0. The theme toggle is a
         separate, independently fixed-position element below and is
         never touched by this: it's a utility control someone may want
         the instant the page loads (e.g. to fix a color scheme that's
         hard to read), not a "welcome, keep exploring" element that
         should wait. -->
    <header
      id="site-nav"
      class="fixed inset-x-0 top-0 z-20 border-b border-slate-900/10 bg-base-light/80 opacity-0 backdrop-blur transition-opacity duration-300 dark:border-white/10 dark:bg-base-dark/80"
    >
      <div class="mx-auto flex max-w-5xl items-center justify-between py-4 pl-6 pr-16">
        <a href="/" class="flex items-center gap-2 font-display text-base font-semibold">
          <img src="/logo-mark-light.svg" alt="" width="28" height="28" class="dark:hidden" />
          <img
            src="/logo-mark-dark.svg"
            alt=""
            width="28"
            height="28"
            class="hidden dark:block"
          />
          Axis Repository
        </a>
        <nav class="flex items-center gap-5 text-sm">
          <a href="/docs/" class="hover:text-lime-600 dark:hover:text-lime-400">Docs</a>
          <a href={githubUrl} class="hover:text-lime-600 dark:hover:text-lime-400">
            GitHub{stargazersCount !== null && ` · ★ ${stargazersCount}`}
          </a>
        </nav>
      </div>
    </header>

    <Toggle
      aria-label="Toggle theme"
      style="width: 1.25rem; height: 1.25rem;"
      class="fixed top-6 right-6 z-30 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
    />

    <slot />

    <script>
      // Nav starts hidden (server-rendered opacity-0, see the header's
      // class list) so there's no flash of it being visible before this
      // runs, and reveals as soon as the page leaves scrollY 0 -- not
      // after any particular section, just "has the user scrolled at
      // all."
      //
      // The header is `fixed`, not `sticky`, so it never reserves layout
      // space: with `sticky` it still occupied its own height at the very
      // top even at opacity 0, which pushed the hero's own background
      // start down by that same height and showed as a flat strip of the
      // plain page background above the hero's gradient -- a visible
      // seam, worst in dark mode. `fixed` overlays instead, so the hero's
      // background runs all the way to the real top of the page and
      // there's nothing for the invisible header to create a gap in
      // front of.
      function setupNavReveal(): void {
        const nav = document.getElementById("site-nav");
        if (!nav) return;

        function reveal(): void {
          nav!.classList.remove("opacity-0");
          nav!.removeAttribute("inert");
        }

        function hide(): void {
          nav!.classList.add("opacity-0");
          nav!.setAttribute("inert", "");
        }

        function update(): void {
          if (window.scrollY > 8) reveal();
          else hide();
        }

        update();
        window.addEventListener("scroll", update, { passive: true });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupNavReveal);
      } else {
        setupNavReveal();
      }
      document.addEventListener("astro:page-load", setupNavReveal);
    </script>
  </body>
</html>
