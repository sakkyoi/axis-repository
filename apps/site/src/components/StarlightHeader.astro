---
import Default from "@astrojs/starlight/components/Header.astro";
import PreviewBanner from "./PreviewBanner.astro";

const variant = import.meta.env.PUBLIC_SITE_VARIANT;
const version = import.meta.env.PUBLIC_SITE_VERSION;
const showBanner = variant === "preview" && Boolean(version);
---
{showBanner && (
  <style is:global>
    /*
     * PageFrame.astro (Starlight core) sizes the fixed header box, the
     * sidebar's top offset, and the main content's top padding all from
     * this one variable (see @astrojs/starlight/style/props.css for the
     * 3.5rem/4rem defaults being added to below). Without bumping it, the
     * sidebar and content start where the *unmodified* nav height ends,
     * overlapping the taller header this banner creates.
     */
    :root {
      --sl-nav-height: calc(3.5rem + 2rem);
    }
    @media (min-width: 50rem) {
      :root {
        --sl-nav-height: calc(4rem + 2rem);
      }
    }

    /*
     * PageFrame's own `header.header` applies --sl-nav-pad-y/-x padding
     * (plus extra padding-inline-end reserved for the mobile menu toggle)
     * to its content -- fine for the nav row, wrong for a full-bleed
     * banner nested inside the same box. @astrojs/starlight's own styles
     * live in `@layer starlight.core`, so this plain, unlayered rule wins
     * automatically without needing !important. The same padding is
     * reapplied below to .site-header-nav only, so the nav row keeps its
     * original spacing and only the banner spans edge to edge.
     */
    header.header {
      padding: 0;
    }
  </style>
)}
<div class="site-header">
  <PreviewBanner variant={variant} version={version} />
  <div class="site-header-nav">
    <Default {...Astro.props}><slot /></Default>
  </div>
</div>

<style>
  .site-header {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Default's own Header markup is `height: 100%`; wrapping it lets that
     resolve against the space flexbox leaves after the banner, instead of
     against the full (now taller) header box. Padding replicates what
     PageFrame's header.header normally carries itself (zeroed above so
     the banner can bleed full-width), including the extra inline-end
     space PageFrame reserves for the mobile menu toggle. */
  .site-header-nav {
    flex: 1;
    min-height: 0;
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    padding-inline-end: var(--sl-nav-pad-x);
  }

  :global([data-has-sidebar]) .site-header-nav {
    padding-inline-end: calc(
      var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
    );
  }

  @media (min-width: 50rem) {
    :global([data-has-sidebar]) .site-header-nav {
      padding-inline-end: var(--sl-nav-pad-x);
    }
  }
</style>
