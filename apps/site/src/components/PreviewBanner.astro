---
interface Props {
  variant: string | undefined;
  version: string | undefined;
}

const { variant, version } = Astro.props;
const showBanner = variant === "preview" && Boolean(version);
---
{showBanner && (
  <div class="bg-amber-200 px-4 py-2 text-center text-sm text-amber-900">
    Preview build @ {version}
  </div>
)}
