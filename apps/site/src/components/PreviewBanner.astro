---
interface Props {
  variant: string | undefined;
  version: string | undefined;
}

const { variant, version } = Astro.props;
const showBanner = variant === "preview" && Boolean(version);
---
{showBanner && (
  <div class="preview-banner">
    Preview build @ {version}
  </div>
)}

<style>
  /*
   * Plain scoped CSS rather than Tailwind utility classes: this component
   * renders both from MarketingLayout (which imports the Tailwind
   * stylesheet) and from StarlightHeader (which deliberately does not, to
   * keep Tailwind's preflight reset away from Starlight's own styling), so
   * Tailwind classes here would silently do nothing on docs pages. The
   * explicit 2rem height is also what StarlightHeader.astro adds to
   * `--sl-nav-height` to make room for this bar -- keep them in sync.
   */
  .preview-banner {
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #fde68a;
    color: #78350f;
    font-size: 0.875rem;
    text-align: center;
  }
</style>
