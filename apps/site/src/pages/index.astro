---
import { Toggle } from "astro-theme-toggle/components";
import MarketingLayout from "../layouts/MarketingLayout.astro";

const deployUrl =
  "https://deploy.workers.cloudflare.com/?url=https://github.com/sakkyoi/axis-repository";
const githubUrl = "https://github.com/sakkyoi/axis-repository";

let stargazersCount: number | null = null;
try {
  const response = await fetch("https://api.github.com/repos/sakkyoi/axis-repository");
  if (response.ok) {
    const data = (await response.json()) as { stargazers_count: number };
    stargazersCount = data.stargazers_count;
  }
} catch {
  // Build-time-only enhancement -- if the GitHub API is unreachable or rate
  // limited, the button still renders, just without a count.
}
---
<MarketingLayout title="Axis Repository">
  <Toggle
    aria-label="Toggle theme"
    style="width: 2.25rem; height: 2.25rem;"
    class="fixed top-6 right-6 rounded-md p-1.5 text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-900"
  />
  <main class="mx-auto max-w-3xl px-6 py-24">
    <div class="flex flex-col items-center text-center">
      <img
        src="/logo-mark-light.svg"
        alt="Axis Repository"
        width="96"
        height="96"
        class="dark:hidden"
      />
      <img
        src="/logo-mark-dark.svg"
        alt="Axis Repository"
        width="96"
        height="96"
        class="hidden dark:block"
      />

      <h1 class="mt-6 text-4xl font-bold tracking-tight">Axis Repository</h1>
      <p class="mt-4 max-w-xl text-lg text-slate-600 dark:text-slate-400">
        A lightweight, multi-format artifact repository built on the edge.
      </p>

      <a
        href="/docs/"
        class="mt-8 rounded-md bg-lime-400 px-6 py-2.5 font-medium text-slate-900 transition hover:bg-lime-300"
      >
        Read the docs
      </a>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
        <a href={deployUrl}>
          <img
            alt="Deploy to Cloudflare"
            src="https://deploy.workers.cloudflare.com/button"
            height="32"
          />
        </a>
        <a
          href={githubUrl}
          class="flex h-8 items-center gap-1.5 rounded-md border border-slate-300 px-3 text-sm font-medium transition hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-600"
        >
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          GitHub
          {stargazersCount !== null && (
            <span class="text-slate-500 dark:text-slate-400">★ {stargazersCount}</span>
          )}
        </a>
      </div>
    </div>

    <p class="mx-auto mt-20 max-w-xl text-center text-slate-600 dark:text-slate-400">
      Bring packages and build artifacts from multiple ecosystems into one place. Axis supports{" "}
      <code class="text-sm text-slate-800 dark:text-slate-200">apt</code> and{" "}
      <code class="text-sm text-slate-800 dark:text-slate-200">PyPI</code> today, with more formats
      defined as plugins, and provides a unified platform without requiring a separate registry
      deployment for each package ecosystem. Its serverless architecture simplifies deployment and
      reduces the infrastructure that needs to be maintained.
    </p>

    <footer class="mt-20 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 border-t border-slate-200 pt-8 text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400">
      <a href={githubUrl} class="hover:text-slate-900 dark:hover:text-slate-100">GitHub</a>
      <a href="/docs/" class="hover:text-slate-900 dark:hover:text-slate-100">Documentation</a>
      <a href={`${githubUrl}/blob/main/LICENSE`} class="hover:text-slate-900 dark:hover:text-slate-100">
        License
      </a>
    </footer>
  </main>
</MarketingLayout>
