---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { Icon } from "astro-icon/components";

const githubUrl = "https://github.com/sakkyoi/axis-repository";

// Cargo has no mark of its own in the simple-icons set, so it borrows Rust's,
// the same way the apt card borrows Debian's. Rust's mark is defined
// black-on-transparent, so it uses the theme's own text color instead of a
// fixed hex to stay visible in dark mode.
const formats = [
  {
    name: "apt",
    icon: "simple-icons:debian",
    iconColor: "text-[#A81D33]",
    description:
      "Publish .deb packages and install them with apt, from signed indexes it verifies.",
    snippet:
      "deb [signed-by=/usr/share/keyrings/axis-my-repo.gpg] https://axis.example.com/repositories/my-repo noble main",
  },
  {
    name: "PyPI",
    icon: "simple-icons:pypi",
    iconColor: "text-[#3775A9]",
    description: "Publish wheels and source distributions and install them with pip.",
    snippet:
      "pip install --index-url https://axis.example.com/repositories/my-repo/simple/ my-package",
  },
  {
    name: "npm",
    icon: "simple-icons:npm",
    iconColor: "text-[#CB3837]",
    description: "Publish npm packages and install them with npm or pnpm.",
  },
  {
    name: "Cargo",
    icon: "simple-icons:rust",
    iconColor: "text-slate-800 dark:text-slate-200",
    description: "Publish crates and pull them with cargo.",
  },
  {
    name: "Go",
    icon: "simple-icons:go",
    iconColor: "text-[#00ADD8]",
    description: "Serve a Go module proxy that go get and go mod resolve against.",
  },
  {
    name: "Docker",
    icon: "simple-icons:docker",
    iconColor: "text-[#2496ED]",
    description: "Host container images and pull them with docker.",
  },
];
---
<MarketingLayout title="Axis Repository">
  <section class="relative flex min-h-[78vh] flex-col items-center justify-center overflow-hidden px-6 py-16 text-center">
    <!-- Signature element: an abstract branching line -- one trunk forking
         into limbs and tines, reading equally as antlers (the logo's "axis"
         deer) or as a distribution tree (one deployment, several package
         ecosystems branching off it). Faint, behind the copy, never
         competing with it. -->
    <svg
      viewBox="0 0 700 520"
      class="pointer-events-none absolute left-1/2 top-1/2 h-[520px] w-[700px] -translate-x-1/2 -translate-y-1/2 text-lime-600/25 dark:text-lime-400/20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M350,520 L350,320" />
      <path d="M350,320 Q280,270 210,220" />
      <path d="M210,220 Q175,170 125,110" />
      <path d="M210,220 Q205,180 200,135" />
      <path d="M210,220 Q185,245 150,260" />
      <path d="M350,320 Q420,270 490,220" />
      <path d="M490,220 Q525,170 575,110" />
      <path d="M490,220 Q495,180 500,135" />
      <path d="M490,220 Q515,245 550,260" />
    </svg>
    <div
      class="pointer-events-none absolute left-1/2 top-1/3 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-lime-400/20 blur-3xl dark:bg-lime-400/10"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-2xl">
      <img
        src="/logo-mark-light.svg"
        alt=""
        width="112"
        height="112"
        class="mx-auto mb-6 dark:hidden"
      />
      <img
        src="/logo-mark-dark.svg"
        alt=""
        width="112"
        height="112"
        class="mx-auto mb-6 hidden dark:block"
      />
      <h1 class="font-display text-6xl font-bold tracking-tight text-balance">
        Axis Repository
      </h1>
      <p class="mt-6 text-xl text-slate-600 dark:text-slate-400">
        A lightweight, multi-format artifact repository built on the edge.
      </p>

      <span class="mt-6 inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-400/10 px-3 py-1 text-xs font-medium text-amber-700 dark:border-amber-400/30 dark:text-amber-400">
        <Icon name="lucide:triangle-alert" size={12} aria-hidden="true" />
        Under active development — not production-ready yet
      </span>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/docs/"
          class="flex h-10 items-center rounded-md bg-lime-400 px-6 font-medium text-slate-900 transition hover:bg-lime-300"
        >
          Get Started
        </a>
        <a
          href={githubUrl}
          class="flex h-10 items-center gap-1.5 rounded-md border border-slate-300 px-4 text-sm font-medium transition hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-600"
        >
          <Icon name="simple-icons:github" size={16} aria-hidden="true" />
          GitHub<span data-github-star-count></span>
        </a>
      </div>
    </div>

    <a
      href="#what-is-axis"
      aria-label="Scroll down"
      class="absolute bottom-8 left-1/2 flex h-9 w-9 -translate-x-1/2 items-center justify-center rounded-full border border-slate-300 text-slate-500 transition hover:border-slate-400 hover:text-slate-900 dark:border-slate-700 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-100"
    >
      <Icon name="lucide:chevron-down" size={16} aria-hidden="true" />
    </a>
  </section>

  <section id="what-is-axis" class="bg-pine-900 px-6 py-16 text-pine-50 dark:bg-pine-950">
    <h2 class="text-center font-mono text-sm font-semibold tracking-widest text-lime-400/80 uppercase">
      What is Axis
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-center leading-relaxed">
      Axis Repository is a lightweight, multi-format artifact repository designed to run at the
      edge. Brings multiple package ecosystems into a single deployment you own, instead of a
      separate registry for each.
    </p>
  </section>

  <section class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center font-display text-sm font-semibold tracking-widest text-slate-500 uppercase dark:text-slate-500">
        Supported formats
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          formats.map((format) => (
            <div class="min-w-0 rounded-lg border border-slate-200 p-6 dark:border-slate-800">
              <div class="flex items-center gap-2">
                <Icon name={format.icon} size={18} class={format.iconColor} aria-hidden="true" />
                <h3 class="font-display text-sm font-semibold text-lime-600 dark:text-lime-400">
                  {format.name}
                </h3>
                {!format.snippet && (
                  <span class="rounded-full border border-slate-300 px-2 py-0.5 font-mono text-[10px] font-medium tracking-wide text-slate-500 uppercase dark:border-slate-700 dark:text-slate-400">
                    Coming soon
                  </span>
                )}
              </div>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{format.description}</p>
              {format.snippet && (
                <pre class="mt-4 overflow-x-auto rounded-md bg-slate-900 p-3 font-mono text-xs whitespace-pre-wrap break-all text-slate-100"><code>{format.snippet}</code></pre>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <footer class="border-t border-slate-200 px-6 py-8 dark:border-slate-800">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-slate-500 dark:text-slate-400">
      <a href={githubUrl} class="hover:text-slate-900 dark:hover:text-slate-100">GitHub</a>
      <a href="/docs/" class="hover:text-slate-900 dark:hover:text-slate-100">Documentation</a>
      <a href={`${githubUrl}/blob/main/LICENSE`} class="hover:text-slate-900 dark:hover:text-slate-100">
        License
      </a>
    </div>
    <p class="mt-4 text-center text-xs text-slate-400 dark:text-slate-600">
      Made with <Icon name="mdi:heart" size={12} class="inline-block align-[-1px] text-red-500" aria-hidden="true" /> by <a href="https://github.com/sakkyoi" class="hover:text-slate-900 dark:hover:text-slate-100">sakkyoi</a>
    </p>
  </footer>
</MarketingLayout>
