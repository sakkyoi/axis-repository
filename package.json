{
  "name": "axis-repository",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm --filter @axis-repository/core build && pnpm --filter @axis-repository/admin-ui build && pnpm --filter @axis-repository/publish-client build && pnpm --filter @axis-repository/runtime-cloudflare build:worker",
    "dev:ui": "pnpm --filter @axis-repository/admin-ui dev",
    "dev:worker": "wrangler dev --local",
    "lint": "eslint .",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm -r typecheck"
  },
  "devDependencies": {
    "@axis-repository/admin-ui": "workspace:^",
    "@axis-repository/core": "workspace:^",
    "@axis-repository/publish-client": "workspace:^",
    "@axis-repository/runtime-cloudflare": "workspace:^",
    "@cloudflare/workers-types": "^5",
    "@eslint/js": "^9",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "lucide-react": "^1.25.0",
    "openpgp": "^6.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vitest": "^2.1.8",
    "wrangler": "^4.114.0",
    "zod": "^4.4.3"
  }
}
