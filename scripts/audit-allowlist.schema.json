{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["allowed"],
  "properties": {
    "allowed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "package", "severity", "reason", "reviewBy"],
        "properties": {
          "id": { "type": "string" },
          "package": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "moderate", "high", "critical"]
          },
          "reason": { "type": "string" },
          "reviewBy": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
